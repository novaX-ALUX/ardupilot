--- a/libraries/GCS_MAVLink/GCS_Signing.cpp
+++ b/libraries/GCS_MAVLink/GCS_Signing.cpp
@@ -163,6 +163,27 @@ void GCS_MAVLINK::load_signing_key(void)
     }
 }
 
+/*
+  Force an immediate signing-timestamp save on every RTC (GPS) time update?
+
+  Upstream default is 1, which assumes the signing key lives in FRAM (see the
+  "structure stored in FRAM" comment above): a write there is cheap.
+
+  On boards whose StorageManager is flash-emulated (STORAGE_FLASH_PAGE, no FRAM)
+  this is not cheap. AP_GPS calls AP::rtc().set_utc_usec() on every GPS update
+  with a 3D fix (5-10 Hz), each accepted update forces a 44-byte storage write,
+  the storage sector fills within tens of seconds and the resulting flash sector
+  erase "stops the whole MCU" (AP_HAL_ChibiOS/Storage.cpp) for ~250 ms. The stall
+  overruns the UART FIFOs, which shows up as GPS overruns / "GPS not healthy" and
+  delayed frames while disarmed.
+
+  Boards that set this to 0 fall back to the periodic (30 s) save path, which is
+  the same granularity upstream already accepts for the non-forced call site.
+ */
+#ifndef AP_MAVLINK_SIGNING_FORCE_SAVE_TIMESTAMP
+#define AP_MAVLINK_SIGNING_FORCE_SAVE_TIMESTAMP 1
+#endif
+
 /*
   update signing timestamp. This is called when we get GPS lock
   timestamp_usec is since 1/1/1970 (the epoch)
@@ -189,7 +210,7 @@ void GCS_MAVLINK::update_signing_timestamp(uint64_t timestamp_usec)
     }
 
     // save to stable storage
-    save_signing_timestamp(true);
+    save_signing_timestamp(AP_MAVLINK_SIGNING_FORCE_SAVE_TIMESTAMP);
 }
 
 

